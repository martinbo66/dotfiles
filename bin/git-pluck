#!/usr/bin/env bash

# Exit on error, undefined variables, and prevent pipe errors from being masked
set -euo pipefail

# Color codes for output
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Print error message in red and exit
# Usage: fail ["message"]
fail() {
    if [ $# -gt 0 ]; then
        echo -e "${RED}$1${NC}" >&2
    fi
    exit 1
}

# Print command in cyan and execute it
# Usage: execute_cmd "command"
execute_cmd() {
    echo -e "${CYAN}$1${NC}"
    eval "$1" || fail
}

# Display usage information and exit
usage_and_exit() {
    cat <<-EOF
git pluck <path_to_other_project> <SHA>

Cherry-picks a commit identified by SHA from another Git repository
into the current repository.

Example:

git pluck ../rails-starter ab1df43
EOF
    exit 2
}

# Find git repository from given path
# Returns the path to the git repository or exits with error
# Usage: find_repository "path"
find_repository() {
    local path="$1"
    
    # Check if path exists
    if [ ! -e "$path" ]; then
        fail "$path does not exist"
    fi
    
    # Check for .git directory or bare repository
    if [ -d "$path/.git" ]; then
        echo "$path/.git"
    elif [ -d "$path" ] && [ -f "$path/config" ]; then
        # Might be a bare repository
        echo "$path"
    else
        fail "$path is not a git repository"
    fi
}

# Pluck a commit from another repository
# Usage: pluck "git_dir" "sha"
pluck() {
    local git_dir="$1"
    local sha="$2"
    
    # Escape the paths for shell
    git_dir=$(printf '%q' "$git_dir")
    sha=$(printf '%q' "$sha")
    
    # Execute git commands
    execute_cmd "git fetch --quiet --no-tags $git_dir"
    execute_cmd "git cherry-pick $sha"
}

# Main script
main() {
    # Check for help flags
    if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
        usage_and_exit
    fi
    
    # Validate argument count
    if [ $# -ne 2 ]; then
        usage_and_exit
    fi
    
    # Get repository path and SHA
    local repo
    repo=$(find_repository "$1")
    local sha="$2"
    
    # Execute pluck
    pluck "$repo" "$sha"
}

# Run main function if script is being executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi